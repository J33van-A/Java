    public static double[] budget() {
        Scanner in = new Scanner(System.in);
        Random random = new Random();

        int amountglobal = 0;
        String[] budnameback = new String[100];
        double[] budamountback = new double[100];
        int y = 0;
        int action;

        do {
            System.out.println("\n\n1. Make Budgets");
            System.out.println("2. Input Information To Budgets");
            System.out.println("3. Exit");
            System.out.print("\n\nEnter Here: ");
            action = in.nextInt();

            if (action == 1) {
                System.out.print("\n\nPlease let us know how many items you would like to make budgets for: ");
                System.out.print("\n\nNote: By redoing this actio you will creat new budgets.\n ");
                int amount = in.nextInt();

                String[] budname = new String[amount];
                double[] budamount = new double[amount];

                for (int i = 0; i < amount; i++) {
                    System.out.print("\n\nPlease type in the name of the budget: ");
                    System.out.print("\nEnter Here: ");
                    String name = in.next();
                    budname[i] = name;

                    System.out.print("\nPlease type the amount for the budget: ");
                    System.out.print("\nEnter Here: ");
                    double tot = in.nextDouble();
                    budamount[i] = tot;
                }

                amountglobal = amount;
                budnameback = budname;
                budamountback = budamount;
            } else if (action == 2) {
                if (amountglobal > 0) {
                    System.out.println("\n\nWhich number would you like to input: ");
                    for (int x = 0; x < amountglobal; x++) {
                        System.out.println((x + 1) + "." + budnameback[x] + "\t" + budamountback[x]);
                    }

                    System.out.print("\n\nEnter Here: ");
                    int action2 = in.nextInt();

                    if (action2 >= 1 && action2 <= amountglobal) {
                        System.out.print("\nHow much did you spend? ");
                        System.out.print("\nEnter Here: ");
                        double spent = in.nextDouble();

                        if (spent >= 0 && budamountback[action2 - 1] >= spent) {
                            System.out.println("\nCongratulations! You have stayed under/below your budget.");
                        } else if (spent >= 0 && budamountback[action2 - 1] < spent) {
                            System.out.println("\nYou have exceeded your budget by " + (spent - budamountback[action2 - 1]));
                        } else {
                            System.out.println("\nInvalid input. Please enter a valid amount.");
                        }
                    } else {
                        System.out.println("\nInvalid input. Please enter a valid number.");
                    }
                } else {
                    System.out.println("\nPlease make budgets first before inputting information.");
                }
            } else if (action == 3) {
                y = 1;
            } else {
                System.out.println("\nInvalid option. Please choose a valid option.");
            }
        } while (y == 0);
        return budamountback;
    }

